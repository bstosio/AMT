#!/bin/bash
# AMT.app – uruchamia AMT dwuklikiem w Finderze (z ikoną aplikacji).
# Gdy biblioteki nie są jeszcze zainstalowane, otwiera Terminal z instalacją (amt.sh).
REPO="$(cd "$(dirname "$0")/../../.." && pwd)"      # folder, w którym leży AMT.app
AMT_DIR="${AMT_HOME:-$HOME/.amt}"
PY="$AMT_DIR/venv/bin/python"
STAMP="$AMT_DIR/.amt-deps-$(cksum < "$REPO/requirements.txt" | cut -d' ' -f1)"

if [ -x "$PY" ] && [ -f "$STAMP" ]; then
  exec "$PY" "$REPO/amt.py" "$@"
fi
osascript -e "tell application \"Terminal\" to do script \"bash '$REPO/amt.sh'\"" \
          -e 'tell application "Terminal" to activate'
